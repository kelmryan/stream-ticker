# ============================================================
# STREAM TICKER APP — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=generate-a-random-string-here

# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@localhost:5432/stream_ticker

# --- Twitch OAuth ---
# Register at https://dev.twitch.tv/console
# Redirect URI: {APP_URL}/auth/twitch/callback
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# --- Encryption ---
# Used to encrypt user tokens at rest in the database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate-a-64-char-hex-string
